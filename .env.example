# ── The web app you log into (UI only) ──────────────────────────────────────
#
# This is the website URL — the one you open in your browser to log in.
# The actual APIs might be on a completely different host. That's fine.
# This URL is ONLY used for login and page navigation.
#
UI_URL=https://your-app.example.com

# Path to the login page (relative to UI_URL)
LOGIN_PATH=/login

# Page to navigate to after login (relative to UI_URL)
# If your URL has a dynamic key that changes each session, leave this blank
# and pass the full URL at runtime:  npm run audit -- --url "https://..."
TARGET_PATH=/your/target/page


# ── API comparison ───────────────────────────────────────────────────────────
#
# NEW_API_BASE is the new API server you want to test.
#
# How it works:
#   1. Browser calls  https://old-api.company.com/api/paycheck?id=42
#   2. Tool captures it and replays:
#                     https://new-api.company.com/api/paycheck?id=42
#                     └── only the HOST changes, everything else stays ──┘
#
# Note: this is the API host, NOT the UI URL. They are often different.
#
NEW_API_BASE=https://your-new-api.example.com


# ── Which APIs to audit ──────────────────────────────────────────────────────
#
# Comma-separated path fragments. Only API calls whose URL contains one of
# these strings will be captured. Leave blank to capture nothing.
#
# Example:
#   AUDIT_APIS=/api/paycheck,/api/timesheet,/api/employees
#
AUDIT_APIS=
