# Base URL of the application to capture API calls from
APP_BASE_URL=https://nitor-timesheet.nitorinfotech.net

# Path to navigate to after login (relative to APP_BASE_URL)
TARGET_PATH=/timesheet/360

# Login path (relative to APP_BASE_URL)
LOGIN_PATH=/login

# (Optional) New base URL to compare against — can also be passed via --newBase CLI flag
# NEW_BASE_URL=https://staging.example.com
